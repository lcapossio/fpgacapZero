# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Vivado project and generated tool state
.Xil/
vivado/
*.jou
*.log
*.backup.*
dfx_runtime.txt
clockInfo.txt

# Build artifacts
dist/
packages/
build/
*.bit
*.bin
!host/fcapz/gui/assets/default_window_state_v6.bin
!host/fcapz/gui/assets/default_window_state_v7.bin

# FPGA example build output (vendor toolchains) -- keep example *source* tracked
# Gowin: build dir + stale snapshots
examples/*/out/
examples/*/out_stale_*/
# Intel/Altera Quartus: generated databases, checkpoints, outputs
examples/**/qdb/
examples/**/dni/
examples/**/incremental_db/
examples/**/output_files/
examples/**/tmp-clearbox/
examples/**/*.qws
# Local capture output
examples/*/captures/
# Soft-CPU firmware build artifacts (regenerated at build time; ELF baked or
# packed into BRAM). *.bin is already ignored globally above.
examples/**/fw/*.elf
examples/**/fw/*.map
examples/**/fw/*.mem
# Fetched, pinned VexRiscv core (examples/*/vex/get_deps.py drops it in)
examples/**/vex/VexRiscv*.v
# Vivado in-memory / block-design scratch written at the repo root
/.srcs/

# Simulation artifacts
sim/*.vvp
sim/*.vcd
sim/ghdl/
*.cf

# OS
.DS_Store
Thumbs.db

# Temp test outputs
tests/_tmp/
.codex_pytest_tmp*/
.codex_tmp/
.claude/
examples/de25_nano/de25_nano_quartus/
examples/de25_nano/de25_nano_vex_quartus/
examples/de25_nano/output_files/
examples/de25_nano/captures/

# Local-only working notes (per PROJECTS.md no_commit/ convention)
no_commit/
