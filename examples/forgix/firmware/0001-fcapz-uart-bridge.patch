diff --git a/firmware/pico/include/board_config.h b/firmware/pico/include/board_config.h
index cc47002..55fcc9d 100644
--- a/firmware/pico/include/board_config.h
+++ b/firmware/pico/include/board_config.h
@@ -75,4 +75,49 @@
 #define FPGA_EXTRA_CLOCK_BYTES 32
 #endif
 
+/* ---------------------------------------------------------------------------
+ * fpgacapZero UART bridge
+ *
+ * After the FPGA is configured the RP2354 stops being a bitstream loader and
+ * becomes a transparent pipe between USB CDC and the FPGA fabric, so the host
+ * can reach an fcapz_uart_tap instance over the board's single USB-C cable.
+ *
+ * No extra wiring is needed: the bridge reuses the configuration SPI pins,
+ * which are idle once DONE is high.
+ *
+ *   GPIO2 (was SPI CCK, FPGA CCK pin)  ->  UART0 TX  ->  fabric uart_rxd
+ *   GPIO3 (was SPI CDI, FPGA CDI pin)  <-  UART0 RX  <-  fabric uart_txd
+ *
+ * CCK and CDI are dual-purpose Trion configuration pins: Efinix AN006 Table 3
+ * says they may be used as general I/O in user mode.  (CDONE is a *dedicated*
+ * pin and cannot be, which is why the return path is CDI and not DONE.)
+ *
+ * GPIO2/GPIO3 need pad function 11, UART_AUX.  The ordinary GPIO_FUNC_UART
+ * (function 2) maps to UART0 CTS/RTS on these two pads, not TX/RX, so using it
+ * here produces a dead link rather than a build error.
+ * ------------------------------------------------------------------------ */
+
+#ifndef FCAPZ_BRIDGE_ENABLE
+#define FCAPZ_BRIDGE_ENABLE 1
+#endif
+
+#ifndef FCAPZ_BRIDGE_UART
+#define FCAPZ_BRIDGE_UART uart0
+#endif
+
+/* FPGA CCK pin: RP2354 -> fabric. */
+#ifndef FCAPZ_BRIDGE_PIN_TX
+#define FCAPZ_BRIDGE_PIN_TX 2
+#endif
+
+/* FPGA CDI pin: fabric -> RP2354. */
+#ifndef FCAPZ_BRIDGE_PIN_RX
+#define FCAPZ_BRIDGE_PIN_RX 3
+#endif
+
+/* Must match the BAUD_RATE parameter of the fcapz_uart_tap instance. */
+#ifndef FCAPZ_BRIDGE_BAUD_HZ
+#define FCAPZ_BRIDGE_BAUD_HZ 1000000u
+#endif
+
 #endif
