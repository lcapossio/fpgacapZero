+
+
+#if FCAPZ_BRIDGE_ENABLE
+/*
+ * Transparent USB-CDC <-> UART bridge for fpgacapZero.
+ *
+ * Entered once the FPGA reports DONE, and never left: the T8 has no
+ * configuration flash, so every power-up has to run the loader again anyway.
+ * A reset therefore returns the board to loader mode, which makes an escape
+ * sequence unnecessary -- and, more importantly, keeps arbitrary fcapz scan
+ * payloads from ever being mistaken for one.
+ *
+ * Bytes are moved without interpretation in either direction; the framing is
+ * entirely between the host transport and the fcapz_uart_tap core in fabric.
+ */
+static void fcapz_bridge_run(void) {
+    uart_init(FCAPZ_BRIDGE_UART, FCAPZ_BRIDGE_BAUD_HZ);
+    gpio_set_function(FCAPZ_BRIDGE_PIN_TX, GPIO_FUNC_UART);
+    gpio_set_function(FCAPZ_BRIDGE_PIN_RX, GPIO_FUNC_UART);
+    uart_set_hw_flow(FCAPZ_BRIDGE_UART, false, false);
+    uart_set_format(FCAPZ_BRIDGE_UART, 8, 1, UART_PARITY_NONE);
+    uart_set_fifo_enabled(FCAPZ_BRIDGE_UART, true);
+
+    for (;;) {
+        /* Host -> fabric.  getchar_timeout_us(0) polls without blocking, so
+         * neither direction can starve the other. */
+        int c = getchar_timeout_us(0);
+        while (c != PICO_ERROR_TIMEOUT) {
+            if (uart_is_writable(FCAPZ_BRIDGE_UART)) {
+                uart_putc_raw(FCAPZ_BRIDGE_UART, (char)c);
+                c = getchar_timeout_us(0);
+            } else {
+                break;      /* let the UART drain before taking more */
+            }
+        }
+
+        /* Fabric -> host. */
+        while (uart_is_readable(FCAPZ_BRIDGE_UART)) {
+            putchar_raw(uart_getc(FCAPZ_BRIDGE_UART));
+        }
+
+        tight_loop_contents();
+    }
 }
+#endif
 
