                            "data");
 }
 
+#if FCAPZ_BRIDGE_ENABLE
+/*
+ * GPIO2/GPIO3 reach UART0 TX/RX only through pad function 11 (UART_AUX);
+ * function 2 is CTS/RTS on these pads.  Named GPIO_FUNC_UART_AUX in recent
+ * Pico SDKs; fall back to the raw value so an older SDK still builds.
+ */
+#ifndef FCAPZ_BRIDGE_PAD_FUNC
+#ifdef GPIO_FUNC_UART_AUX
+#define FCAPZ_BRIDGE_PAD_FUNC GPIO_FUNC_UART_AUX
+#else
+#define FCAPZ_BRIDGE_PAD_FUNC ((gpio_function_t)11)
+#endif
+#endif
+
+/*
+ * Take the configuration SPI pins over for the UART.
+ *
+ * Called the instant DONE is confirmed, and deliberately not later: the fabric
+ * starts driving its UART TX pin (the FPGA's CDI) as soon as it enters user
+ * mode, while the RP2354's SPI TX pad still drives the same net.  That is an
+ * output-output conflict, so the window has to be closed before any call that
+ * might block -- sending the ACK, or flushing USB.
+ */
+static void fcapz_bridge_claim_pins(void) {
+    spi_deinit(FPGA_SPI_INSTANCE);
+
+    uart_init(FCAPZ_BRIDGE_UART, FCAPZ_BRIDGE_BAUD_HZ);
+    gpio_set_function(FCAPZ_BRIDGE_PIN_TX, FCAPZ_BRIDGE_PAD_FUNC);
+    gpio_set_function(FCAPZ_BRIDGE_PIN_RX, FCAPZ_BRIDGE_PAD_FUNC);
+    uart_set_hw_flow(FCAPZ_BRIDGE_UART, false, false);
+    uart_set_format(FCAPZ_BRIDGE_UART, 8, 1, UART_PARITY_NONE);
+    uart_set_fifo_enabled(FCAPZ_BRIDGE_UART, true);
+}
+
+/*
+ * Transparent USB-CDC <-> UART bridge for fpgacapZero.
+ *
+ * Entered once the FPGA reports DONE, and never left: the T8 has no
+ * configuration flash, so every power-up has to run the loader again anyway.
+ * A reset therefore returns the board to loader mode, which makes an escape
+ * sequence unnecessary -- and, more importantly, keeps arbitrary fcapz scan
+ * payloads from ever being mistaken for one.
+ *
+ * Bytes are moved without interpretation in either direction; the framing is
+ * entirely between the host transport and the fcapz_uart_tap core in fabric.
+ */
+static void fcapz_bridge_run(void) {
+    for (;;) {
+        /* Host -> fabric.  getchar_timeout_us(0) polls without blocking, so
+         * an idle host cannot stall the other direction.  Once a byte has been
+         * taken out of the CDC buffer it must be handed on: uart_putc_raw()
+         * spins until the TX FIFO has room, which is the only way to apply
+         * backpressure without dropping it.  A 256-bit scan is 37 contiguous
+         * bytes, so a full FIFO is routine, not a corner case. */
+        int c = getchar_timeout_us(0);
+        while (c != PICO_ERROR_TIMEOUT) {
+            uart_putc_raw(FCAPZ_BRIDGE_UART, (char)c);
+            c = getchar_timeout_us(0);
+        }
+
+        /* Fabric -> host. */
+        while (uart_is_readable(FCAPZ_BRIDGE_UART)) {
+            putchar_raw(uart_getc(FCAPZ_BRIDGE_UART));
+        }
+
+        tight_loop_contents();
+    }
+}
+#endif
+
 static void handle_end(const struct forge_frame *frame, struct loader_context *ctx) {
     if (ctx->state != LOADER_PROGRAMMING) {
         protocol_send_response(FORGE_RESP_NACK,
@@ -207,12 +280,28 @@ static void handle_end(const struct forge_frame *frame, struct loader_context *c
     }
 
     ctx->state = LOADER_DONE;
+
+#if FCAPZ_BRIDGE_ENABLE
+    /* DONE is high, so configuration is over: hand CCK/CDI to the UART now,
+     * before anything that can block on USB.  Until spi_deinit() runs, the
+     * SPI TX pad and the fabric's UART TX are both driving CDI. */
+    fcapz_bridge_claim_pins();
+#endif
+
     protocol_send_response(FORGE_RESP_ACK,
                            frame->sequence,
                            FORGE_OK,
                            fpga_config_pin_state(),
                            bytes_written_low(ctx),
                            "fpga programmed");
+
+#if FCAPZ_BRIDGE_ENABLE
+    /* The ACK above is the last framed message: hand the CDC port to the
+     * fabric so fcapz can talk to it.  Flushed first, or the reply would be
+     * stranded in the USB buffer when framing stops. */
+    stdio_flush();
+    fcapz_bridge_run();
+#endif
 }
 
