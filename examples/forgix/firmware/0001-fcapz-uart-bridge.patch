index ac87d06..e280c48 100644
--- a/firmware/pico/src/main.c
+++ b/firmware/pico/src/main.c
@@ -1,8 +1,11 @@
 #include <stdbool.h>
 #include <stdint.h>
 
+#include "board_config.h"
 #include "crc32.h"
 #include "fpga_config.h"
